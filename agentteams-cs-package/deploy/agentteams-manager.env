# AgentTeams Manager Configuration
# Generated by agentteams-install.ps1 on 2026-08-10 09:24:44

# Language
AGENTTEAMS_LANGUAGE=zh

# LLM
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_DEFAULT_MODEL=deepseek-chat
AGENTTEAMS_LLM_API_KEY=sk-YOUR_DEEPSEEK_API_KEY
AGENTTEAMS_OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENTTEAMS_MODEL_CONTEXT_WINDOW=
AGENTTEAMS_MODEL_MAX_TOKENS=
AGENTTEAMS_MODEL_REASONING=
AGENTTEAMS_MODEL_VISION=

# Embedding model (empty = disabled, default: text-embedding-v4)
AGENTTEAMS_EMBEDDING_MODEL=text-embedding-v4

# Admin
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Ports
AGENTTEAMS_LOCAL_ONLY=1
AGENTTEAMS_PORT_GATEWAY=18080
AGENTTEAMS_PORT_CONSOLE=18001
AGENTTEAMS_PORT_ELEMENT_WEB=18088
AGENTTEAMS_PORT_MANAGER_CONSOLE=18888

# Matrix
AGENTTEAMS_MATRIX_DOMAIN=matrix-local.agentteams.io:18080
AGENTTEAMS_MATRIX_CLIENT_DOMAIN=matrix-client-local.agentteams.io

# Gateway
AGENTTEAMS_AI_GATEWAY_DOMAIN=aigw-local.agentteams.io
AGENTTEAMS_MANAGER_GATEWAY_KEY=CHANGE_ME_GATEWAY_KEY

# File System
AGENTTEAMS_FS_DOMAIN=fs-local.agentteams.io
AGENTTEAMS_CONSOLE_DOMAIN=console-local.agentteams.io
AGENTTEAMS_MINIO_USER=admin
AGENTTEAMS_MINIO_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Internal
AGENTTEAMS_MANAGER_PASSWORD=CHANGE_ME_MANAGER_PASSWORD
AGENTTEAMS_REGISTRATION_TOKEN=CHANGE_ME_REGISTRATION_TOKEN

# GitHub (optional)
AGENTTEAMS_GITHUB_TOKEN=

# Nacos package import defaults
AGENTTEAMS_NACOS_REGISTRY_URI=nacos://market.agentteams.io:80/public
AGENTTEAMS_NACOS_USERNAME=
AGENTTEAMS_NACOS_PASSWORD=
AGENTTEAMS_NACOS_TOKEN=

# Skills Registry (optional, default: nacos://market.agentteams.io:80/public)
AGENTTEAMS_SKILLS_API_URL=nacos://market.agentteams.io:80/public

# OpenClaw CMS plugin (optional)
AGENTTEAMS_CMS_TRACES_ENABLED=false
AGENTTEAMS_CMS_ENDPOINT=
AGENTTEAMS_CMS_LICENSE_KEY=
AGENTTEAMS_CMS_PROJECT=
AGENTTEAMS_CMS_WORKSPACE=
AGENTTEAMS_CMS_SERVICE_NAME=agentteams-manager
AGENTTEAMS_CMS_METRICS_ENABLED=false

# Worker images (for direct container creation)
AGENTTEAMS_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-worker:latest
AGENTTEAMS_COPAW_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-copaw-worker:latest
AGENTTEAMS_QWENPAW_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-qwenpaw-worker:latest
AGENTTEAMS_HERMES_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-hermes-worker:latest

# Manager runtime (openclaw | copaw)
AGENTTEAMS_MANAGER_RUNTIME=copaw

# Default Worker runtime (openclaw | copaw | hermes)
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=copaw

# Matrix E2EE (0=disabled, 1=enabled; default: 0)
AGENTTEAMS_MATRIX_E2EE=0

# Docker API proxy (0=disabled, 1=enabled; default: 1)
AGENTTEAMS_DOCKER_PROXY=0

# Docker API proxy: additional allowed image sources (comma-separated)
AGENTTEAMS_PROXY_ALLOWED_REGISTRIES=

# Worker idle timeout in minutes (default: 720 = 12 hours)
AGENTTEAMS_WORKER_IDLE_TIMEOUT=720

# JVM Args for Higress Console
JVM_ARGS=

# Higress WASM plugin image registry (auto-selected by timezone)
HIGRESS_ADMIN_WASM_PLUGIN_IMAGE_REGISTRY=higress-registry.cn-hangzhou.cr.aliyuncs.com

# Data persistence
AGENTTEAMS_DATA_DIR=agentteams-data
# Manager workspace (skills, memory, state - host-editable)
AGENTTEAMS_WORKSPACE_DIR=C:\Users\qilin\agentteams-manager
# Host directory sharing
AGENTTEAMS_HOST_SHARE_DIR=C:\Users\qilin
